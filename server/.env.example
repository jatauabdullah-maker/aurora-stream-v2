# Port (Render sets this automatically)
PORT=3000

# Mistral decision brain — comma-separated keys (rotated on rate limit)
# Leave empty to run pure skill-based logic only
MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-small-latest

# Resolved-link cache TTL in minutes (clamped 30–90)
CACHE_TTL_MINUTES=45

# Pacing between episodes in a batch (milliseconds)
PACE_MIN_MS=5000
PACE_MAX_MS=10000
