{
  "name": "aurora-stream",
  "private": true,
  "version": "3.0.0",
  "description": "Aurora Stream — a premium installable anime streaming PWA with offline downloads.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "ext:zip": "powershell -NoProfile -Command \"Remove-Item public/aurora-downloader.zip -Force -EA SilentlyContinue; Compress-Archive -Path extension/aurora-downloader -DestinationPath public/aurora-downloader.zip -Force\"",
    "ext:check": "node -e \"['pipeline.js','background.js','bridge.js'].forEach(f=>new Function(require('fs').readFileSync('extension/aurora-downloader/'+f,'utf8')));console.log('extension JS OK')\"",
    "deploy": "vercel deploy --prod --yes"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "framer-motion": "^13.0.0",
    "plyr": "^3.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
