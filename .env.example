# Base URL of YOUR content source/API. The app calls these endpoints:
#   GET  {VITE_API_BASE_URL}/trending
#   GET  {VITE_API_BASE_URL}/popular
#   GET  {VITE_API_BASE_URL}/recent
#   GET  {VITE_API_BASE_URL}/search?q=&genre=&year=&status=&page=
#   GET  {VITE_API_BASE_URL}/anime/:id
#   GET  {VITE_API_BASE_URL}/anime/:id/episodes
#   GET  {VITE_API_BASE_URL}/stream/:episodeId  -> { sources: [{url, quality, type}], subtitles: [{url, lang}] }
#
# Point this at whatever source/backend you plug in.
# Copy to .env.local

# Leave EMPTY to use AniList for catalog + embed sources for streaming (works out of the box).
# Point to YOUR backend when ready — see "API contract" in README:
VITE_API_BASE_URL=

# Optional: Resolver API for direct MP4 downloads (AnimePahe pipeline).
# Deploy the resolver service (server/) to Render/Railway/Fly.io and set this URL.
# Example: VITE_RESOLVER_API=https://your-resolver.onrender.com/api/resolve-stream
VITE_RESOLVER_API=