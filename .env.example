# Aurora Stream — environment
#
# Nothing here is required. With an empty VITE_API_BASE_URL the app uses
# AniList for the catalog and embed sources for streaming, which works
# out of the box. Copy this file to .env.local to override.

# Base URL of your own content API. When set, Aurora calls:
#   GET {VITE_API_BASE_URL}/trending
#   GET {VITE_API_BASE_URL}/popular
#   GET {VITE_API_BASE_URL}/recent
#   GET {VITE_API_BASE_URL}/search?q=&genre=&year=&status=&page=
#   GET {VITE_API_BASE_URL}/anime/:id
#   GET {VITE_API_BASE_URL}/anime/:id/episodes
#   GET {VITE_API_BASE_URL}/stream/:episodeId
#        -> { sources: [{ url, quality, type }], subtitles: [{ url, lang }] }
#
# Leave empty to use AniList + embed sources.
VITE_API_BASE_URL=