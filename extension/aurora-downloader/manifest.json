{
  "manifest_version": 3,
  "name": "Aurora Downloader",
  "version": "2.0.0",
  "description": "Automatic anime downloads for Aurora Stream. Runs entirely in your browser — no servers, your IP, your rules.",
  "key": "",
  "permissions": ["tabs", "downloads", "downloads.open", "scripting", "storage", "webRequest", "declarativeNetRequest", "windows"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aurora-anime.vercel.app/*",
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
